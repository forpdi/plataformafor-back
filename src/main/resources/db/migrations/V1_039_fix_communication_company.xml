<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="V1_039" author="eduardo.sakae">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="fpdi_communication" columnName="company_id"/>
            </not>
        </preConditions>

        <addColumn tableName="fpdi_communication">
            <column name="company_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="fpdi_communication"
                baseColumnNames="company_id"
                referencedTableName="fpdi_company"
                referencedColumnNames="id"
                constraintName="fk_communication_company"/>
    </changeSet>

</databaseChangeLog>
